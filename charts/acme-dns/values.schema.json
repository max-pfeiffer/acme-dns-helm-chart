{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "acme-dns",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "services", "config", "database"],
  "properties": {
    "database": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": { "type": "string", "enum": ["sqlite", "postgres"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "strategy": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "rollingUpdate": { "type": "object" }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "containerPorts": {
      "type": "object",
      "required": ["api", "dnsTcp", "dnsUdp"],
      "additionalProperties": false,
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dnsTcp": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dnsUdp": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "services": {
      "type": "object",
      "required": ["api", "dns"],
      "properties": {
        "api": {
          "type": "object",
          "required": ["type", "ports"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "ports": {
              "type": "object",
              "required": ["api"],
              "properties": {
                "api": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "labels": { "type": "object" },
                "annotations": { "type": "object" }
              }
            }
          }
        },
        "dns": {
          "type": "object",
          "required": ["type", "ports"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "ports": {
              "type": "object",
              "required": ["dnsTcp", "dnsUdp"],
              "properties": {
                "dnsTcp": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "dnsUdp": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "labels": { "type": "object" },
                "annotations": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array" },
        "rules": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "sqliteVolumeSize": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|k|Ei|Pi|Ti|Gi|Mi|Ki)?$"
    },
    "sqliteStorageClass": { "type": "string" },
    "config": { "type": "string" }
  }
}
