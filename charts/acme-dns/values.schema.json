{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "acme-dns",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "services", "config"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "services": {
      "type": "object",
      "required": ["api", "dns"],
      "properties": {
        "api": {
          "type": "object",
          "required": ["type", "ports"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "ports": {
              "type": "object",
              "required": ["api"],
              "properties": {
                "api": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "labels": { "type": "object" },
                "annotations": { "type": "object" }
              }
            }
          }
        },
        "dns": {
          "type": "object",
          "required": ["type", "ports"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "ports": {
              "type": "object",
              "required": ["dnsTcp", "dnsUdp"],
              "properties": {
                "dnsTcp": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "dnsUdp": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "metadata": {
              "type": "object",
              "properties": {
                "labels": { "type": "object" },
                "annotations": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array" },
        "rules": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "sqliteVolumeSize": { "type": "string" },
    "config": { "type": "string" }
  }
}
